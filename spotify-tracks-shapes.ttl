@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix mo:      <http://purl.org/ontology/mo/> .
# gotta use the namespace that we register on w3id.org, rn its a placeholder
@prefix ex:      <https://w3id.org/spotify-tracks/terms/> .
@prefix shapes:  <https://w3id.org/spotify-tracks/shapes/> .

<https://w3id.org/spotify-tracks/shapes>
    a owl:Ontology ;
    dcterms:title "SHACL shapes for the Spotify Tracks Linked Data Application Profile"@en ;
    dcterms:description "Machine-checkable version of the EXE3 constraints matrix."@en .

# Track  (mo:Track)
shapes:TrackShape
    a sh:NodeShape ;
    sh:targetClass mo:Track ;
    sh:nodeKind sh:IRI ;

    # properties where existing ontologies can be used
    sh:property [   # ID
        sh:path dcterms:identifier ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z0-9]{22}$" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track needs exactly one Spotify identifier (22 alphanumeric characters)." ;
    ] ;
    sh:property [   # song title
        sh:path dcterms:title ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A track has at most one title (a title may be missing in the source)." ;
    ] ;
    sh:property [   # song artist
        sh:path mo:performer ;
        sh:class mo:MusicArtist ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Credited artists must be IRIs of mo:MusicArtist." ;
    ] ;
    sh:property [   # release
        sh:path dcterms:isPartOf ;
        sh:class mo:Release ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A track belongs to at most one release (IRI of mo:Release)." ;
    ] ;
    sh:property [   # genre
        sh:path ex:spotifyGenre ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A track needs at least one genre (the source genre label, as xsd:string)." ;
    ] ;
    sh:property [   # duration
        sh:path mo:duration ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track needs exactly one duration in milliseconds (xsd:float, >= 0)." ;
    ] ;

    # properties for spotify's own audio feature scores
    sh:property [   # danceability
        sh:path ex:spotifyDanceability ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify danceability score in [0,1]." ;
    ] ;
    sh:property [   # energy
        sh:path ex:spotifyEnergy ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify energy score in [0,1]." ;
    ] ;
    sh:property [   # acousticness
        sh:path ex:spotifyAcousticness ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify acousticness score in [0,1]." ;
    ] ;
    sh:property [   # instrumentalness
        sh:path ex:spotifyInstrumentalness ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify instrumentalness score in [0,1]." ;
    ] ;
    sh:property [   # liveness
        sh:path ex:spotifyLiveness ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify liveness score in [0,1]." ;
    ] ;
    sh:property [   # speechiness
        sh:path ex:spotifySpeechiness ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify speechiness score in [0,1]." ;
    ] ;
    sh:property [   # valence
        sh:path ex:spotifyValence ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A track must have exactly one Spotify valence score in [0,1]." ;
    ] ;

    # the rest of the features, also minting since there are no ontologies for them
    sh:property [   # popularity
        sh:path ex:spotifyPopularity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ; sh:maxInclusive 100 ;
        sh:minCount 1 ;
        sh:message "Popularity must be an integer in 0..100 (at least one value; the source may report different values per genre row)." ;
    ] ;
    sh:property [   # explicit
        sh:path ex:spotifyExplicit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Explicit flag must be exactly one xsd:boolean (false may also mean unknown)." ;
    ] ;
    sh:property [   # bpm
        sh:path ex:tempoBpm ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Tempo must be exactly one xsd:decimal >= 0 (BPM)." ;
    ] ;
    sh:property [   # loudness
        sh:path ex:spotifyLoudnessDb ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Loudness must be exactly one xsd:decimal in dB (may be positive)." ;
    ] ;
    sh:property [   # song key
        sh:path ex:keyCode ;
        sh:datatype xsd:integer ;
        sh:minInclusive -1 ; sh:maxInclusive 11 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Key code must be exactly one integer in -1..11 (-1 = undetected)." ;
    ] ;
    sh:property [   # song mode
        sh:path ex:modeCode ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Mode code must be exactly one integer: 0 (minor) or 1 (major)." ;
    ] ;
    sh:property [   # time signature
        sh:path ex:timeSignatureCode ;
        sh:datatype xsd:integer ;
        sh:minInclusive 3 ; sh:maxInclusive 7 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Time-signature code must be exactly one integer in 0..7." ;
    ] .

# Artist  (mo:MusicArtist)
shapes:ArtistShape
    a sh:NodeShape ;
    sh:targetClass mo:MusicArtist ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path foaf:name ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An artist needs exactly one non-empty foaf:name." ;
    ] .

# Release  (mo:Release)
shapes:ReleaseShape
    a sh:NodeShape ;
    sh:targetClass mo:Release ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path dcterms:title ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A release needs exactly one non-empty dcterms:title." ;
    ] .
